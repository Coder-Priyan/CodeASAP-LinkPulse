# ==============================================================================
# LinkPulse Automated Test Environment Configuration
# ==============================================================================
# To run the automated test suite without risking destructive cleanups against
# your development or live Neon database, configure an isolated database URL below.
#
# Option A: Local Docker PostgreSQL (Recommended)
# docker run --name linkpulse-test-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=linkpulse_test -p 5433:5432 -d postgres:16-alpine
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/linkpulse_test?schema=public"
#
# Option B: Dedicated Neon Isolated Branch
# Create an ephemeral test branch in the Neon console (isolated from main/dev):
# TEST_DATABASE_URL="postgresql://[user]:[password]@ep-isolated-test-branch.aws.neon.tech/linkpulse?sslmode=require"
# ==============================================================================

TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/linkpulse_test?schema=public"
