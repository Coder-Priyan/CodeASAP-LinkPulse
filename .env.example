# LinkPulse Environment Configuration

# PostgreSQL Database URL (Compatible with Neon, Supabase, Railway, AWS RDS, local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkpulse?schema=public"

# Direct connection string for Prisma migrations (if using poolers like PgBouncer/Neon pooled URL)
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/linkpulse?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session JWT secret (min 32 characters in production)
JWT_SECRET="super-secret-linkpulse-production-key-change-in-production-min32chars"

# Salt for privacy-safe visitor SHA-256 identifier (independent from JWT_SECRET)
VISITOR_SALT="distinct-salt-for-privacy-safe-visitor-hashing-min32chars"

# Node environment
NODE_ENV="development"
