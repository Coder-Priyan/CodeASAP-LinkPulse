# LinkPulse Environment Configuration

# PostgreSQL Database URL (Compatible with Neon, Supabase, Railway, AWS RDS, local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkpulse?schema=public"

# Direct connection string required by schema.prisma (set to the same value as DATABASE_URL if not using a pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/linkpulse?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session JWT secret (min 32 characters in production)
JWT_SECRET="super-secret-linkpulse-production-key-change-in-production-min32chars"

# Salt for privacy-safe visitor SHA-256 identifier (independent from JWT_SECRET)
VISITOR_SALT="distinct-salt-for-privacy-safe-visitor-hashing-min32chars"

# Node environment
NODE_ENV="development"

# Seed script configuration (Required only when running npm run prisma:seed)
# Must equal "yes" to allow running the destructive wipe & seed script
SEED_CONFIRM=""

# Passwords for seeded demo accounts (must be at least 12 characters)
SEED_ADMIN_PASSWORD=""
SEED_USER_PASSWORD=""

# Passcode for sample password-protected link (/roadmap)
SEED_LINK_PASSCODE=""

# Diagnostic & Profiling (Optional: set to "true" to print all executed SQL queries)
# PRISMA_LOG_QUERIES="false"

# Test Database Safety Guard Configuration (Required only when running full "npm test")
# Must differ from DATABASE_URL and target a local host or a database containing "test" in its name.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/linkpulse_test?schema=public"
# TEST_DIRECT_URL="postgresql://postgres:postgres@localhost:5433/linkpulse_test?schema=public"
# ALLOW_REMOTE_TEST_DB="1" # Only set to 1 to intentionally allow an isolated remote database without "test" in its name

